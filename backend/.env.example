PORT=5000
REQUEST_TIMEOUT_MS=15000
PAGE_DELAY_MS=500
MAX_PAGES=10
# For ~50 products per listing page, 150 items needs pages 1–3; we auto-use at least ceil(limit/LIST_PAGE_SIZE)+1 pages.
LIST_PAGE_SIZE=50
# Max time for scrape + CSV write (ms). Myntra multi-page + Puppeteer needs several minutes.
SCRAPE_REQUEST_TIMEOUT_MS=300000

# Puppeteer (Windows): if you see "Could not find Chrome", either run
#   npm run puppeteer:install
# or point to your Chrome install, for example:
# PUPPETEER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# Or use system Chrome without a path:
# PUPPETEER_CHANNEL=chrome
# Optional: custom cache directory for downloaded browser
# PUPPETEER_CACHE_DIR=C:\\Users\\YourName\\.cache\\puppeteer
